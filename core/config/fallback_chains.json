        "strategy_3_startfile: os.startfile(app_name) — Windows shell resolution",
        "strategy_4_powershell: PowerShell Start-Process",
        "strategy_5_exe_retry: Append .exe and retry os.startfile",
        "strategy_6_start_menu: Search Start Menu shortcuts (user + system-wide)",
        "strategy_7_install_dirs: Search common install directories"
      ],
      "verifier": "application.launch_app"
    },
    "close_app": {
      "description": "Close an app gracefully, then force with 3-method fallback",
      "methods": [
        "method_1_graceful: proc.CloseMainWindow()",
