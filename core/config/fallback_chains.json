{
  "_comment": "Fallback strategy per action type — which methods to try and in what order (269 actions)",
  "filesystem": {
    "delete_file": {
      "description": "Delete a file with 7-method fallback chain",
      "methods": [
        "method_1_os_remove: os.remove(path)",
        "method_2_win32file: win32file.DeleteFileW(path)",
        "method_3_cmd_del: subprocess.run(['cmd', '/c', 'del', '/F', '/Q', path])",
        "method_4_clear_attributes: SetFileAttributesW(path, NORMAL) -> os.remove(path)",
        "method_5_take_ownership: take_ownership(path) -> set_full_permissions(path) -> os.remove(path)",
        "method_6_kill_locking: kill_locking_process(path) -> os.remove(path)",
        "method_7_delay_reboot: MoveFileExW(path, null, MOVEFILE_DELAY_UNTIL_REBOOT)"
      ],
      "verifier": "filesystem.delete_file"
    },
    "create_file": {
      "description": "Create a file with 3-method fallback",
      "methods": [
        "method_1_pathlib: Path(path).write_text(content)",
        "method_2_open_builtin: open(path, 'w').write(content)",
        "method_3_powershell: PowerShell Set-Content with base64 encoding"
      ],
      "verifier": "filesystem.create_file"
    },
    "copy_file": {
      "description": "Copy a file with 3-method fallback",
      "methods": [
        "method_1_shutil: shutil.copy2(src, dst)",
        "method_2_win32file: win32file.CopyFileW(src, dst)",
        "method_3_cmd_copy: subprocess.run(['cmd', '/c', 'copy', '/Y', src, dst])"
      ],
      "verifier": "filesystem.copy_file"
    },
    "move_file": {
      "description": "Move/rename a file with 3-method fallback",
      "methods": [
        "method_1_pathlib: Path(src).rename(dst)",
        "method_2_shutil: shutil.move(src, dst)",
        "method_3_win32file: win32file.MoveFileW(src, dst)"
      ],
      "verifier": "filesystem.move_file"
    },
    "create_folder": {
      "description": "Create a directory with 2-method fallback",
      "methods": [
        "method_1_pathlib: Path(path).mkdir(parents=True, exist_ok=True)",
        "method_2_powershell: New-Item -ItemType Directory"
      ],
      "verifier": "filesystem.create_folder"
    },
    "read_file": {
      "description": "Read file content with 2-method fallback",
      "methods": [
        "method_1_pathlib: Path(path).read_text(encoding='utf-8')",
        "method_2_powershell: Get-Content -Path path -Raw"
      ],
      "verifier": "filesystem.read_file"
    },
    "list_directory": {
      "description": "List directory contents with 2-method fallback",
      "methods": [
        "method_1_pathlib: Path(path).iterdir()",
        "method_2_powershell: Get-ChildItem with JSON output"
      ],
      "verifier": "filesystem.list_directory"
    },
    "search_files": {
      "description": "Search files by pattern with 2-method fallback",
      "methods": [
        "method_1_pathlib: Path(path).rglob(pattern)",
        "method_2_powershell: Get-ChildItem -Recurse -Filter pattern"
      ],
      "verifier": "filesystem.search_files"
    }
  },
  "process": {
    "kill_process": {
      "description": "Kill a process with 5-method fallback chain",
      "methods": [
        "method_1_psutil: psutil.Process(pid).kill()",
        "method_2_win32api: win32api.TerminateProcess(OpenProcess(pid))",
        "method_3_taskkill: subprocess.run(['taskkill', '/F', '/PID', str(pid)])",
        "method_4_taskkill_tree: subprocess.run(['taskkill', '/F', '/T', '/PID', str(pid)])",
        "method_5_max_access: Open with max access rights -> TerminateProcess"
      ],
      "verifier": "process.kill_process"
    },
    "launch_process": {
      "description": "Launch a new process with 3-method fallback",
      "methods": [
        "method_1_subprocess: subprocess.Popen(cmd)",
        "method_2_powershell: PowerShell Start-Process",
        "method_3_os_system: os.system('start ' + cmd)"
      ],
      "verifier": "process.launch_process"
    },
    "suspend_process": {
      "description": "Suspend a process via NtSuspendProcess",
      "methods": [
        "method_1_ctypes: ntdll.NtSuspendProcess(handle)",
        "method_2_powershell: PowerShell Suspend method"
      ],
      "verifier": "process.suspend_process"
    },
    "resume_process": {
      "description": "Resume a suspended process via NtResumeProcess",
      "methods": [
        "method_1_ctypes: ntdll.NtResumeProcess(handle)",
        "method_2_powershell: PowerShell Resume method"
      ],
      "verifier": "process.resume_process"
    },
    "set_priority": {
      "description": "Set process priority with 2-method fallback",
      "methods": [
        "method_1_psutil: psutil.Process(pid).nice(priority)",
        "method_2_powershell: Get-Process | ForEach-Object { $_.PriorityClass = 'High' }"
      ],
      "verifier": "process.set_priority"
    },
    "kill_process_tree": {
      "description": "Kill entire process tree",
      "methods": [
        "method_1_taskkill_tree: taskkill /F /T /PID",
        "method_2_psutil: psutil.Process(pid).kill()"
      ],
      "verifier": "process.kill_process_tree"
    }
  },
  "application": {
